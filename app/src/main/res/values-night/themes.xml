<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Material 3 style, follows system day/night. -->
    <style name="Theme.SignatureKill" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorPrimaryVariant">@color/m3_primary_container</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorSecondaryVariant">@color/m3_secondary_container</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorAccent">@color/m3_primary</item>

        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>

        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:windowBackground">@color/m3_background</item>
        <item name="android:statusBarColor">@color/m3_background</item>

        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/AlertTitleStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MaterialAlertDialog.Rounded</item>
    </style>

    <style name="AlertTitleStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AlertBodyStyle" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/m3_on_surface_variant</item>
    </style>

    <style name="ThemeOverlay.AlertDialog.Rounded" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SignatureKill.AlertDialog</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AlertTitleStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AlertBodyStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="ShapeAppearanceOverlay.SignatureKill.AlertDialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialAlertDialog.Rounded" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/m3_primary</item>
    </style>

    <style name="NeutralButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/m3_primary</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/m3_primary</item>
    </style>

</resources>
